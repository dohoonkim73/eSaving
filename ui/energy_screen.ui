    </property>
    <property name="styleSheet">
     <string notr="true">QLabel {
   /* 1. 배경을 주변보다 살짝 어둡게 (푹 패인 바닥 역활) */
    /*background-color: #D6DCE5; /* 배경색 */
    background-color: #1a1a1b;
   /* 2. 빛의 반대 방향 (좌상단)은 그림자가 져서 어둡게 */
    border-top: 2px solid #B0B9C6;
    border-left: 2px solid #B0B9C6;
  
    /* 3. 빛이 닿는 방향(우하단)은 밝게 빛나도록 */
    border-bottom: 2px solid #FFFFFF;
    border-right: 2px solid #FFFFFF;
   
    /* 4. 부드러운 곡선과 텍스트 설정 */
    border-radius: 1px; /* 둥근 모서리 */
    padding: 1px; /* 내부 여백 */
    /*color: #4A5568; /* 글자색 */
    color: #00ffcc;
    font-family: 'Pretendard', sans-serif;
    font-size: 14px;
    font-weight: bold;
    
}</string>
    </property>
    <property name="text">
     <string/>
    </property>
