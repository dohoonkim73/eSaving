   <property name="styleSheet">
    <string notr="true">QGroupBox {
    font-weight: bold;
    border: 2px solid #bdc3c7; /* 테두리 색상 */
    border-radius: 8px; /* 둥근 모서리 */
    margin-top: 15px; /* 타이틀 공간 확보 */
    background-color: #E0E5EC; /* 배경색 */
    padding: 10px;
    border-top: 2px solid #B0B9C6;
    border-left: 2px solid #B0B9C6;
  
    
    border-bottom: 2px solid #FFFFFF;
    border-right: 2px solid #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left; /* 타이틀 위치 */
    padding: 0 5px;
    color: #2c3e50; /* 타이틀 글자 색상 */
}</string>
