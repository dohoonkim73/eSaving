    <property name="styleSheet">
     <string notr="true">QLabel {
/* 원형 만들기: 너비의 절반*/
border-radius: 10px;

/*입체감을 위한 그라데이션*/
background-color: qradialgradient(
    cx: 0.5, cy: 0.5, radius: 0.8,
    fx: 0.4, fy:0.4,
    stop: 0 #f0f0f0,    /* 중심부: 밝은 연두 */
    stop: 0.5 #888888,  /* 중간 선명한 초록 */
    stop: 1.0 #444444  /* 테두리 어두운 초록 */
);

/* 미세한 테두리로 선명함 추가 */
border: 1px solid #333333;
}</string>
    </property>
